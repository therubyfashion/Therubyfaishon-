    "@capacitor/core": "^6.2.0",
    "@capacitor/share": "^6.0.4",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@google/generative-ai": "^0.24.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
