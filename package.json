{
  "name": "the-ruby-fashion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=1024' vite build",
    "generate-assets": "tsx scripts/copy-assets.ts && npx capacitor-assets generate --android",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "mobile:sync": "npm run build && npx cap sync android",
    "postinstall": "node scripts/patch-google-auth.js"
  },
